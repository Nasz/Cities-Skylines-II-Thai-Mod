#: en
msgid "PhotoMode.PROPERTY_TITLE[CloudLayer.layerA.opacityA]"
msgstr "Wispy clouds opacity"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[CloudLayer.layerA.opacityA]"
