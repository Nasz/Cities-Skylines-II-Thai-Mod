msgid "PhotoMode.PROPERTY_TITLE[CloudLayer.layerA.opacityB]"
msgstr "Cirrus clouds opacity"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[CloudLayer.layerA.opacityB]"
