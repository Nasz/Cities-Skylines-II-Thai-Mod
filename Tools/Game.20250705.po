#: en
msgid "SelectedInfoPanel.TOOLTIP[DestroyedBuildingSection]"
msgstr "This building has been destroyed by a disaster."

#: en
msgid "SelectedInfoPanel.TOOLTIP[DestroyedBuildingSectionRebuild]"
msgstr "Select the Rebuild button to activate the Rebuild Tool. Then select the destroyed building to rebuild it."

#: en
msgid "SelectedInfoPanel.TOOLTIP[DestroyedBuildingSectionSearching]"
msgstr "A Disaster Response Unit has been dispatched to search for survivors."

#: en
msgid "SelectedInfoPanel.TOOLTIP[DestroyedBuildingSectionWaiting]"
msgstr "Waiting for a Disaster Response Unit to be dispatched to the scene."

#: en
msgid "SelectedInfoPanel.TOOLTIP[DestroyedBuildingSectionNoService]"
msgstr "There might be trapped survivors in the building, but there is no Disaster Response Unit available!\r\n\r\nBuild a Disaster Response Unit upgrade to a Fire Station to rescue them!\r\n\r\nIf no Disaster Response Unit is available, the building will clear out eventually by itself."

