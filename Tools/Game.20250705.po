#: en
msgid "PhotoMode.PROPERTY_TITLE[VolumetricClouds.numPrimarySteps]"
msgstr "Number of primary steps"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[VolumetricClouds.numPrimarySteps]"
msgstr "Controls the number of steps when evaluating the clouds' transmittance. A higher value results in a lower noise level and longer view distances."

#: en
msgid "PhotoMode.PROPERTY_TITLE[VolumetricClouds.numLightSteps]"
msgstr "Number of light steps"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[VolumetricClouds.numLightSteps]"
msgstr "Controls the number of steps when evaluating the clouds' lighting. A higher value will lead to smoother lighting and improved self-shadowing."

#: en
msgid "PhotoMode.PROPERTY_TITLE[VolumetricClouds.sunLightDimmer]"
msgstr "Sunlight dimmer"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[VolumetricClouds.sunLightDimmer]"
msgstr "Controls the influence of the sun light on the cloud volume. A lower value will suppress the sun light and produce darker clouds overall."

#: en
msgid "PhotoMode.PROPERTY_TITLE[VolumetricClouds.erosionOcclusion]"
msgstr "Erosion occlusion"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[VolumetricClouds.erosionOcclusion]"
msgstr "Controls how much erosion factor is taken into account when computing ambient occlusion."

#: en
msgid "PhotoMode.PROPERTY_TITLE[VolumetricClouds.scatteringTint]"
msgstr "Scattering tint"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[VolumetricClouds.scatteringTint]"
msgstr "Specifies the tint of the cloud scattering color."

#: en
msgid "PhotoMode.PROPERTY_TITLE[VolumetricClouds.powderEffectIntensity]"
msgstr "Powder effect intensity"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[VolumetricClouds.powderEffectIntensity]"
msgstr "Controls the amount of local scattering in the clouds. A higher value may produce a more powdery or diffused aspect."

#: en
msgid "PhotoMode.PROPERTY_TITLE[VolumetricClouds.multiScattering]"
msgstr "Multi scattering"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[VolumetricClouds.multiScattering]"
msgstr "Controls the amount of multi-scattering inside the cloud."

#: en
msgid "PhotoMode.PROPERTY_TITLE[VolumetricClouds.shadowOpacity]"
msgstr "Shadows opacity"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[VolumetricClouds.shadowOpacity]"
msgstr "Controls the opacity of the volumetric clouds shadow."

#: en
msgid "PhotoMode.CLOUDEROSIONNOISE[Worley32]"
msgstr "Worley"

#: en
msgid "PhotoMode.CLOUDEROSIONNOISE[Perlin32]"
msgstr "Perlin"

#: en
msgid "PhotoMode.PROPERTY_TITLE[Fog.meanFreePath]"
msgstr "Attenuation distance"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[Fog.meanFreePath]"
msgstr "Controls the density at the base of the fog and determines how far you can see through the fog in meters. At this distance, the fog has absorbed and out-scattered 63% of background light."

#: en
msgid "PhotoMode.PROPERTY_TITLE[Fog.baseHeight]"
msgstr "Base height"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[Fog.baseHeight]"
msgstr "Sets the height of the boundary between the constant (homogeneous) fog and the exponential fog."

#: en
msgid "PhotoMode.PROPERTY_TITLE[Fog.maximumHeight]"
msgstr "Maximum height"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[Fog.maximumHeight]"
msgstr "Controls the rate of falloff for the height fog in meters. Higher values stretch the fog vertically. At this height , the falloff reduces the initial base density by 63%."

#: en
msgid "PhotoMode.PROPERTY_TITLE[Fog.maxFogDistance]"
msgstr "Maximum fog distance"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[Fog.maxFogDistance]"
msgstr "Controls the distance in meters."

#: en
msgid "PhotoMode.PROPERTY_TITLE[Fog.tint]"
msgstr "Tint"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[Fog.tint]"
msgstr "Sets a multiplier for the sky color."

#: en
msgid "PhotoMode.PROPERTY_TITLE[Fog.albedo]"
msgstr "Volumetric fog albedo"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[Fog.albedo]"
msgstr "Sets the color of the volumetric fog."

#: en
msgid "PhotoMode.PROPERTY_TITLE[Fog.depthExtent]"
msgstr "Volumetric fog distance"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[Fog.depthExtent]"
msgstr "Controls the distance in meters at which the volumetric fog section of the frustum ends."

#: en
msgid "PhotoMode.PROPERTY_TITLE[Fog.anisotropy]"
msgstr "Volumetric fog anisotropy"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[Fog.anisotropy]"
msgstr "Controls the angular distribution of scattered light. 0 is isotropic, 1 is forward scattering, and -1 is backward scattering."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhysicallyBasedSky.auroraBorealisEmissionMultiplier]"
msgstr "Aurora intensity"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhysicallyBasedSky.auroraBorealisEmissionMultiplier]"
msgstr "Controls the intensity of aurora borealis."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhysicallyBasedSky.airMaximumAltitude]"
msgstr "Maximum air altitude"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhysicallyBasedSky.airMaximumAltitude]"
msgstr "Sets the depth in meters of the atmospheric layer, from sea level, composed of air particles. This controls the rate of height-based density falloff. "

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhysicallyBasedSky.airDensityR]"
msgstr "Air density (Red)"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhysicallyBasedSky.airDensityR]"
msgstr "Sets the red color channel opacity of air at the point in the sky directly above the observer (zenith). This directly affects the color of air at the zenith."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhysicallyBasedSky.airDensityG]"
msgstr "Air density (Green)"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhysicallyBasedSky.airDensityG]"
msgstr "Sets the green color channel opacity of air at the point in the sky directly above the observer (zenith). This directly affects the color of air at the zenith."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhysicallyBasedSky.airDensityB]"
msgstr "Air density (Blue)"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhysicallyBasedSky.airDensityB]"
msgstr "Sets the blue color channel opacity of air at the point in the sky directly above the observer (zenith). This directly affects the color of air at the zenith."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhysicallyBasedSky.airTint]"
msgstr "Air tint"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhysicallyBasedSky.airTint]"
msgstr "Controls the single scattering albedo of air molecules (per color channel). A value of 0 results in absorbing molecules, and a value of 1 results in scattering ones.\r\n"

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhysicallyBasedSky.aerosolMaximumAltitude]"
msgstr "Maximum aerosol altitude"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhysicallyBasedSky.aerosolMaximumAltitude]"
msgstr "Sets the depth in meters of the atmospheric layer, from sea level, composed of aerosol particles. This controls the rate of height-based density falloff."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhysicallyBasedSky.aerosolDensity]"
msgstr "Aerosol density"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhysicallyBasedSky.aerosolDensity]"
msgstr "Sets the opacity of aerosols at the point in the sky directly above the observer (zenith). This directly affects the color of aerosols at the zenith."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhysicallyBasedSky.aerosolTint]"
msgstr "Aerosol tint"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhysicallyBasedSky.aerosolTint]"
msgstr "Controls the single scattering albedo of aerosol molecules (per color channel). A value of 0 results in absorbing molecules, and a value of 1 results in scattering ones."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhysicallyBasedSky.aerosolAnisotropy]"
msgstr "Aerosol anisotropy"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhysicallyBasedSky.aerosolAnisotropy]"
msgstr "Specifies the direction of anisotropy:\r\n• Set this value to 1 for forward scattering.\r\n• Set this value to 0 to make the anisotropy almost isotropic.\r\n• Set this value to -1 for backward scattering.\r\nFor high values of anisotropy:\r\n• If the light path and view direction are aligned, you see a bright atmosphere/fog effect.\r\n• If they are not aligned, you see a dim atmosphere/fog effect.\r\n• If anisotropy is 0, the atmosphere and fog look similar regardless of view direction.\r\n"

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhysicallyBasedSky.colorSaturation]"
msgstr "Color saturation"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhysicallyBasedSky.colorSaturation]"
msgstr "Controls the saturation of the color of the sky."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhysicallyBasedSky.alphaSaturation]"
msgstr "Alpha saturation"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhysicallyBasedSky.alphaSaturation]"
msgstr "Controls the saturation of the opacity of the sky."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhysicallyBasedSky.alphaMultiplier]"
msgstr "Alpha multiplier"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhysicallyBasedSky.alphaMultiplier]"
msgstr "Sets a multiplier to the opacity of the sky."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhysicallyBasedSky.horizonTint]"
msgstr "Horizon tint"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhysicallyBasedSky.horizonTint]"
msgstr "Specifies a color used to tint the sky at the horizon."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhysicallyBasedSky.horizonZenithShift]"
msgstr "Horizon Zenith shift"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhysicallyBasedSky.horizonZenithShift]"
msgstr "Controls how the blends between the horizon tint and zenith tint is performed. For a value of -1, the zenith tint expands down to the horizon. For a value of 1, the horizon tint expands up to the zenith."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhysicallyBasedSky.zenithTint]"
msgstr "Zenith tint"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhysicallyBasedSky.zenithTint]"
msgstr "Specifies a color used to tint the point in the sky directly above the observer (the zenith).\r\n"

#: en
msgid "PhotoMode.PROPERTY_TITLE[VolumetricClouds.shapeOffset/x]"
msgstr "X offset"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[VolumetricClouds.shapeOffset/x]"
msgstr "Controls the world space X component offset applied when evaluating the larger noise passing through the cloud coverage."

#: en
msgid "PhotoMode.PROPERTY_TITLE[VolumetricClouds.shapeOffset/y]"
msgstr "Y offset"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[VolumetricClouds.shapeOffset/y]"
msgstr "Controls the world space Y component offset applied when evaluating the larger noise passing through the cloud coverage."

#: en
msgid "PhotoMode.PROPERTY_TITLE[VolumetricClouds.shapeOffset/z]"
msgstr "Z offset"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[VolumetricClouds.shapeOffset/z]"
msgstr "Controls the world space Z component offset applied when evaluating the larger noise passing through the cloud coverage."

