msgstr "Rounded"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[Vignette.rounded]"
msgstr "When enabled, the vignette is perfectly round. When disabled, the vignette matches shape with the current aspect ratio."

#: en
msgid "PhotoMode.PROPERTY_TITLE[FilmGrain.intensity]"
msgstr "Intensity"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[FilmGrain.intensity]"
msgstr "Set the strength of the film grain effect."

#: en
