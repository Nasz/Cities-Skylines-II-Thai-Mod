#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhotoModeRenderSystem.sensorSize]"
msgstr "Defines the width and height of the sensor that captures the image in millimeters. These affects the aspect ratio."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhotoModeRenderSystem.lensShift]"
msgstr "Lens Shift"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhotoModeRenderSystem.lensShift]"
msgstr "Offsets the camera's lens from its sensor horizontally and vertically. This allows to change the focal center and reposition a subject in the frame with little to no distortion."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhotoModeRenderSystem.aperture]"
msgstr "Aperture"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhotoModeRenderSystem.aperture]"
msgstr "Defines the f-stop (f-number) of the lens. Lower values give a wider lens aperture."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhotoModeRenderSystem.bladeCount]"
msgstr "Blade Count"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhotoModeRenderSystem.bladeCount]"
msgstr "Defines the number of blades in the lens aperture. Higher values give a rounder aperture shape."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhotoModeRenderSystem.curvature]"
msgstr "Curvature"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhotoModeRenderSystem.curvature]"
msgstr "Controls the curvature of the lens aperture blades. The minimum value results in fully-curved, perfectly-circular bokeh, and the maximum value results in visible aperture blades."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhotoModeRenderSystem.barrelClipping]"
msgstr "Barrel Clipping"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhotoModeRenderSystem.barrelClipping]"
msgstr "Controls the self-occlusion of the lens, creating a cat's eye effect."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhotoModeRenderSystem.anamorphism]"
msgstr "Anamorphism"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhotoModeRenderSystem.anamorphism]"
msgstr "Stretches the sensor to simulate an anamorphic look. Positive values distort the Camera vertically, negative will distort the Camera horizontally."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhotoModeRenderSystem.iso]"
msgstr "Iso"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhotoModeRenderSystem.iso]"
msgstr "Sets the light sensitivity of the Camera sensor."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhotoModeRenderSystem.shutterSpeed]"
msgstr "Shutter Speed"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhotoModeRenderSystem.shutterSpeed]"
msgstr "Defines the amount of time in seconds the camera sensor is capturing light."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhotoModeRenderSystem.gateFitMode]"
msgstr "Gate Fit"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[PhotoModeRenderSystem.gateFitMode]"
msgstr "Determines how the rendered area (resolution gate) fits into the sensor area (film gate)."

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhotoModeRenderSystem.lensShift/x]"
msgstr "Horizontal Shift"

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhotoModeRenderSystem.lensShift/y]"
msgstr "Vertical Shift"

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhotoModeRenderSystem.curvature/x]"
msgstr "Minimum"

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhotoModeRenderSystem.curvature/y]"
msgstr "Maximum"

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhotoModeRenderSystem.sensorSize/x]"
msgstr "Width"

#: en
msgid "PhotoMode.PROPERTY_TITLE[PhotoModeRenderSystem.sensorSize/y]"
msgstr "Height"

#: en
msgid "PhotoMode.PROPERTY_TITLE[DepthOfField.focusMode]"
msgstr "Focus Mode"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[DepthOfField.focusMode]"
msgstr "Sets the focus mode for the depth of field. Physical or manual."

#: en
msgid "PhotoMode.PROPERTY_TITLE[DepthOfField.focusDistance]"
msgstr "Focus Distance"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[DepthOfField.focusDistance]"
msgstr "Sets the distance of the focus plane from the camera. Only used with physical focus mode."

#: en
msgid "PhotoMode.PROPERTY_TITLE[DepthOfField.nearFocusStart]"
msgstr "Near Range Start"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[DepthOfField.nearFocusStart]"
msgstr "Sets the distance from the camera at which the near field blur begins to decrease in intensity. Only used with manual focus mode."

#: en
msgid "PhotoMode.PROPERTY_TITLE[DepthOfField.nearFocusEnd]"
msgstr "Near Range End"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[DepthOfField.nearFocusEnd]"
msgstr "Sets the distance from the camera at which the near field does not blur anymore. Only used with manual focus mode."

#: en
msgid "PhotoMode.PROPERTY_TITLE[DepthOfField.farFocusStart]"
msgstr "Far Range Start"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[DepthOfField.farFocusStart]"
msgstr "Sets the distance from the camera at which the far field starts blurring. Only used with manual focus mode."

#: en
msgid "PhotoMode.PROPERTY_TITLE[DepthOfField.farFocusEnd]"
msgstr "Far Range End"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[DepthOfField.farFocusEnd]"
msgstr "Sets the distance from the Camera at which the far field blur reaches its maximum blur radius. Only used with manual focus mode."

#: en
msgid "PhotoMode.PROPERTY_TITLE[DepthOfField.m_NearMaxBlur]"
msgstr "Max Near Blur"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[DepthOfField.m_NearMaxBlur]"
msgstr "Sets the maximum radius the near blur can reach."

#: en
msgid "PhotoMode.PROPERTY_TITLE[DepthOfField.m_FarMaxBlur]"
msgstr "Max Far Blur"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[DepthOfField.m_FarMaxBlur]"
msgstr "Sets the maximum radius the far blur can reach."

#: en
msgid "PhotoMode.PROPERTY_TITLE[MotionBlur.intensity]"
msgstr "Intensity"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[MotionBlur.intensity]"
msgstr "Sets the intensity of the motion blur effect. Acts as a multiplier for velocities."

#: en
msgid "PhotoMode.PROPERTY_TITLE[MotionBlur.minimumVelocity]"
msgstr "Minimum Velocity"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[MotionBlur.minimumVelocity]"
msgstr "Controls the minimum velocity, in pixels, that an object must have to contribute to the motion blur effect."

#: en
msgid "PhotoMode.PROPERTY_TITLE[MotionBlur.maximumVelocity]"
msgstr "Maximum Velocity"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[MotionBlur.maximumVelocity]"
msgstr "Controls the maximum velocity, in pixels, that an object must have to contribute to the motion blur effect."

#: en
msgid "PhotoMode.PROPERTY_TITLE[MotionBlur.depthComparisonExtent]"
msgstr "Depth Comparison Extent"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[MotionBlur.depthComparisonExtent]"
msgstr "Value used for the depth based weighting of samples. Tweak if unwanted leak of background onto foreground or viceversa is detected."

#: en
msgid "PhotoMode.PROPERTY_TITLE[Bloom.threshold]"
msgstr "Treshold"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[Bloom.threshold]"
msgstr "Set the level of brightness to filter out pixels under this level. This value is expressed in gamma-space. A value above 0 will disregard energy conservation rules."

#: en
msgid "PhotoMode.PROPERTY_TITLE[Bloom.intensity]"
msgstr "Intensity"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[Bloom.intensity]"
msgstr "Controls the strength of the bloom filter."

#: en
msgid "PhotoMode.PROPERTY_TITLE[Bloom.scatter]"
msgstr "Scatter"

#: en
msgid "PhotoMode.PROPERTY_TOOLTIP[Bloom.scatter]"
msgstr "Sets the radius of the bloom effect."

