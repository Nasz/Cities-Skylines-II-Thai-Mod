msgstr "Bypass Confirmation"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[RaycastLanesButton]"
msgstr "Remove Net-Lanes"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[SubElementBulldozerButton]"
msgstr "Remove Sub-Elements"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[SurfacesFilterButton]"
msgstr "Surfaces Filter"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[SpacesFilterButton]"
msgstr "Spaces Filter"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[StaticObjectsFilterButton]"
msgstr "Static Objects Filter"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[NetworksFilterButton]"
msgstr "Networks Filter"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[SubElementBulldozerButton]"
msgstr "Removes props, trees, decals, fences, hedges, extensions, and networks from assets. This tool can break connectivity within assets. Some elements are more safe to remove such as: props, trees, decals, fences, hedges, and sub-buildings. Some elements are less safe to remove such as: networks and extensions. You can prohibit removing those in the settings."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[SubElementsOfMainElement]"
msgstr "Sub-Elements of the Main Asset"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[SubElementsOfMainElement]"
msgstr "For removing sub-elements such as props, trees, decals, fences, hedges, extensions, and networks from the main asset."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[UpgradeIsMain]"
msgstr "Sub-Elements of Sub-Buildings and Extensions"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[UpgradeIsMain]"
msgstr "For removing sub-elements such as props, trees, decals belonging to sub-buildings and extensions of the main building."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[Single]"
msgstr "Single Item"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[Single]"
msgstr "Selects a single sub-element at a time. Single removal is not permanent, and will regenerate whenever the asset updates."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[Matching]"
msgstr "Exact Match"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[Matching]"
msgstr "Selects all exactly matching sub-elements within the building, sub-building, extension or network and 'permanently removes' them. (i.e. all oak trees in this asset). 'Permanent removal' means whenever they are regenerated they will automatically be removed again soon afterwards."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[Similar]"
msgstr "Similar Category"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[Similar]"
msgstr "Selects all sub-elements in a similar category within the building, sub-building, extension or network and 'permanently removes' them. Categories include: trees, plants, street lights, trash bins, branding objects and advertisements, activity locations, and all hedges and fences. (i.e. all trees in this asset). 'Permanent removal' means whenever they are regenerated they will automatically be removed again soon afterwards."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[Reset]"
msgstr "Reset Asset"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[Reset]"
msgstr "Reset assets by selecting ones that have any sub-elements 'permanently removed' using Exact Match or Similar Category."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[SingleMovingObject]"
msgstr "Single"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[SingleMovingObject]"
msgstr "Utilizes the vanilla bulldoze tool to remove most single vehicles, cims, or animals. Use radius selection if this cannot remove a vehicle, cim or animal."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[RadiusSelection]"
msgstr "Radius Selection"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[RadiusSelection]"
msgstr "Removes ALL vehicles, cims, or animals within the radius and those in a vertical column above and below where the radius hits the terrain. This can remove broken, stuck, unselectable, and unowned vehicles including those placed by the player, and animals generated by player placed spawners. Vehicles placed by player may have negative impacts on the simulation and are not props."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[IncreaseRadius]"
msgstr "Increase the radius."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[DecreaseRadius]"
msgstr "Decrease the radius."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[AllFilters]"
msgstr "Toggle all Filters on/off"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[AllFilters]"
msgstr "Either selects all or none of the Filters depending on your current selection. Having none selected will prevent the Bulldoze Tool from working."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[BuildingFilter]"
msgstr "Building Filter"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[BuildingFilter]"
msgstr "Toggling this off will prevent the Bulldoze Tool from removing Building assets."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[VanillaNetworksFilter]"
msgstr "Network Filter"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[VanillaNetworksFilter]"
msgstr "Toggling this off will prevent the Bulldoze Tool from removing Network assets such as roads, tracks, and powerlines."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[TreeFilter]"
msgstr "Tree Filter"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[TreeFilter]"
msgstr "Toggling this off will prevent the Bulldoze Tool from removing trees and wild bushes."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[PlantFilter]"
msgstr "Plant Filter"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[PlantFilter]"
msgstr "Toggling this off will prevent the Bulldoze Tool from removing plants that are not trees such as cultivated bushes and potted plants."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[DecalFilter]"
msgstr "Decal Filter"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[DecalFilter]"
msgstr "Toggling this off will prevent the Bulldoze Tool from removing decals."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_TITLE[PropFilter]"
msgstr "Any other Prop Filter"

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[PropFilter]"
msgstr "Toggling this off will prevent the Bulldoze Tool from removing any props that are not trees, plants, or decals."

#: Better_Bulldozer
msgid "BetterBulldozer.TOOLTIP_DESCRIPTION[VanillaSurfaceFilter]"
msgstr "Toggling this off will prevent the Bulldoze Tool from removing surfaces."

#: Better_Bulldozer
msgid "BetterBulldozer.SECTION_TITLE[Tier]"
msgstr "Tier"

#: Better_Bulldozer
msgid "BetterBulldozer.SECTION_TITLE[Selection]"
msgstr "Selection"

#: Better_Bulldozer
msgid "BetterBulldozer.SECTION_TITLE[Radius]"
msgstr "Radius"

#: Better_Bulldozer
msgid "BetterBulldozer.WARNING_TOOLTIP[BulldozeSubelement]"
msgstr "Bulldoze Sub-Element"

#: Better_Bulldozer
msgid "BetterBulldozer.WARNING_TOOLTIP[ExtensionRemovalProhibited]"
msgstr "Removing extensions has been disabled in the settings."

#: Better_Bulldozer
msgid "BetterBulldozer.WARNING_TOOLTIP[RemovingMarkerNetworksProhibited]"
msgstr "Removing sub-element networks has been disabled in the settings."

#: Better_Bulldozer
msgid "BetterBulldozer.WARNING_TOOLTIP[ExtensionRemovalWarning]"
msgstr "Removing some extensions will break assets."

#: Better_Bulldozer
msgid "BetterBulldozer.WARNING_TOOLTIP[SubelementNetworkRemovalWarning]"
msgstr "Removing sub-element networks may break assets."

#: Better_Bulldozer
msgid "BetterBulldozer.WARNING_TOOLTIP[NetworksUseSingleItem]"
msgstr "Removing multiple sub-element networks is not supported. Use Single Item selection instead."

#: Better_Bulldozer
msgid "BetterBulldozer.WARNING_TOOLTIP[RemovingSubelementsFromRoads]"
msgstr "Removing single sub-elements from roads is not recommended due to frequent regeneration."

#: Better_Bulldozer
msgid "BetterBulldozer.WARNING_TOOLTIP[RemovingSubelementsFromGrowable]"
msgstr "Removing single sub-elements from growables that can level up is not recommended due to level up regeneration."

#: Better_Bulldozer
msgid "BetterBulldozer.WARNING_TOOLTIP[RemovingSubelementsFromServiceBuildings]"
msgstr "Recommend purchasing all upgrades before removing single sub-elements from service buildings to avoid regeneration."

